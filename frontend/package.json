{
  "name": "suna-frontend",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node --require ./scripts/libuv-fix.cjs node_modules/vite/bin/vite.js",
    "build": "node --require ./scripts/libuv-fix.cjs node_modules/typescript/bin/tsc --noEmit && node --require ./scripts/libuv-fix.cjs node_modules/vite/bin/vite.js build",
    "test": "node --require ./scripts/libuv-fix.cjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node --require ./scripts/libuv-fix.cjs node_modules/vitest/vitest.mjs",
    "test:boundaries": "node scripts/check-runtime-boundaries.mjs",
    "test:e2e": "node --require ./scripts/libuv-fix.cjs node_modules/playwright/cli.js test",
    "preview": "node --require ./scripts/libuv-fix.cjs node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
