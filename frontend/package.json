{
  "name": "bloomery-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node --require ./scripts/libuv-fix.cjs node_modules/vite/bin/vite.js",
    "build": "node --require ./scripts/libuv-fix.cjs node_modules/typescript/bin/tsc -b && node --require ./scripts/libuv-fix.cjs node_modules/vite/bin/vite.js build",
    "test": "node --require ./scripts/libuv-fix.cjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node --require ./scripts/libuv-fix.cjs node_modules/vitest/vitest.mjs",
    "test:boundaries": "node scripts/check-runtime-boundaries.mjs",
    "test:e2e": "node --require ./scripts/libuv-fix.cjs node_modules/playwright/cli.js test",
    "preview": "node --require ./scripts/libuv-fix.cjs node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "docx-preview": "^0.3.5",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
