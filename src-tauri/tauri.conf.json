{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloomery",
  "version": "1.0.0",
  "identifier": "com.bloomery.desktop",
  "mainBinaryName": "bloomery",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --host 127.0.0.1",
      "cwd": "../frontend"
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bloomery",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../domain-packs/steel": "domain-packs/steel",
      "resources/compute-worker": "compute-worker"
    }
  }
}
